# Server-only. Never prefix secrets with VITE_ or commit .env.local.
# npm run configure:ai prompts for keys without echo and saves the ignored .env.local.
# Use a Groq Free account and a Gemini free-tier project with billing disabled.
ENABLE_FREE_MODEL=false
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional backend routing overrides (allowlisted free-tier models only).
GROQ_EXTRACT_MODEL=openai/gpt-oss-20b
GROQ_REASON_MODEL=openai/gpt-oss-120b
GEMINI_EXTRACT_MODEL=gemini-3.5-flash-lite
GEMINI_REASON_MODEL=gemini-3.8-flash

# Conservative per-isolate limits; the provider's account quotas remain authoritative.
AI_REQUESTS_PER_MINUTE=6
GROQ_TOKENS_PER_MINUTE=7000
GEMINI_TOKENS_PER_MINUTE=18000
AI_LOG_USAGE=false

# Temporary backend-only metadata check; health output never includes credentials or models.
AI_CONNECTION_DIAGNOSTICS=false
